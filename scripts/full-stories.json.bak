        "title": "The Adventure of Johnnie Waverly",
        "url": "https://www.agathachristie.com/stories/the-adventure-of-johnnie-waverly"
      },
      {
        "title": "The Disappearance of Mr Davenheim",
        "url": "https://www.agathachristie.com/stories/the-disappearance-of-davenheim"
      },
      {
        "title": "The Third Floor Flat",
        "url": "https://www.agathachristie.com/stories/third-floor-flat"
      }
    ]
