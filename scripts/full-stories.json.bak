      },
      {
        "title": "The Mystery of the Blue Train",
        "url": "https://www.agathachristie.com/stories/the-mystery-of-the-blue-train"
      },
      {
        "title": "The Apples of Hesperides",
        "url": "https://www.agathachristie.com/stories/the-apples-of-hesperides"
      }
    ]
