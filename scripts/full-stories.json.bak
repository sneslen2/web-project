        "title": "The Bloodstained Pavement",
        "url": "https://www.agathachristie.com/stories/the-bloodstained-pavement"
      },
      {
        "title": "The Actress",
        "url": "https://www.agathachristie.com/stories/the-actress"
      }
    ]
