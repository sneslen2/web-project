    ]
  },
  {
    "title": "The Bloodstained Pavement",
    "type": "Short Story",
    "character": "Miss Marple",
    "year": 1928,
    "url": "https://www.agathachristie.com/stories/the-bloodstained-pavement",
    "cover": "https://agathachristie.imgix.net/image-store/Jacket_MissMarpleTheCompleteShortStories_US.jpg",
    "synopsis": "The Tuesday Night club listen to Joyce's tale of seeing blood stains on the pavement - a warning that a death will occur with 24 hours. Soon after a woman drowns... From The Thirteen Problems.",
    "moreAbout": "Painter Joyce tells the story of a holiday in which she accidentally painted drops of blood on the pavement. She is told that this signifies imminent death and is shocked when a woman drowns. But Miss Marple is not one to believe in coincidences.\n\nWatch out for similarities with 'Triangle at Rhodes', Murder in the Mews, and Evil Under the Sun.\n\nThe story was published in the Royal Magazine in the UK in 1928 and in the US, under the revised title Drip! Drip! later that year. It was included in the 1932 collection, The Thirteen Problems, Miss Marple's first short story collection.\n\nIt has never been adapted.",
    "trivia": [],
    "quote": null,
    "extractPdf": "https://agathachristie.imgix.net/image-store/Read-Christie-2024/ACL_MarpleList_2024.pdf",
    "related": [
      {
        "title": "4.50 From Paddington",
        "url": "https://www.agathachristie.com/stories/450-from-paddington"
      },
      {
        "title": "The Second Murder at the Vicarage",
        "url": "https://www.agathachristie.com/stories/the-second-murder-at-the-vicarage"
      },
      {
        "title": "Midwinter Murder: Fireside Tales from the Queen of Mystery",
        "url": "https://www.agathachristie.com/stories/midwinter-murder"
      }
    ]
  },
  {
    "title": "The Idol House of Astarte",
    "type": "Short Story",
    "character": "Miss Marple",
    "year": 1928,
    "url": "https://www.agathachristie.com/stories/the-idol-house-of-astarte",
    "cover": "https://agathachristie.imgix.net/image-store/Jacket_MissMarpleTheCompleteShortStories_US.jpg",
    "synopsis": "The Tuesday Night Club discuss a fancy dress party where a man was stabbed. But no one was close enough to have murdered him... From The Thirteen Problems.",
    "moreAbout": "Dr Pender presents this mystery for this week's Tuesday Night Club. At a fancy dress party, a man is stabbed, but how, when no one was close enough to attack him. The Club discuss the details of the case but it seems only Miss Marple knows the truth of the matter.\n\nPublished in 1928 in the Royal Magazine in the UK and Detective Story Magazine in the US. In the US the story had the title The Solving Six and the Evil Hour. It was included in the collection The Thirteen Problems in 1932, Miss Marple's first short story collection.\n\nIt has never been adapted.",
    "trivia": [],
